# ============================================================================
#  Copy to `.env` and fill in. `.env` is gitignored - never commit real values.
#  Load into your shell before running:  (PowerShell)  Get-Content .env | ...
#  or rely on docker-compose / your IDE run config to inject these.
# ============================================================================

# ---- Spring profile: local (Groq) or prod (Gemini) ----
SPRING_PROFILES_ACTIVE=local

# ---- LLM provider keys (only the active profile's key is required) ----
# Groq (local profile) - free tier: https://console.groq.com
GROQ_API_KEY=
# Gemini (prod profile) - free tier: https://aistudio.google.com
GEMINI_API_KEY=
# Optional model override (defaults: llama-3.3-70b-versatile local / gemini-2.0-flash prod)
LLM_MODEL=
# Per-file LLM review timeout in seconds (default 30)
LLM_TIMEOUT_SECONDS=30

# ---- GitHub integration ----
# Fine-grained PAT with pull_requests:read+write on the target repos.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
# Shared secret configured on the GitHub webhook (HMAC-SHA256).
GITHUB_WEBHOOK_SECRET=
# Post review comments back to the PR; false = dry-run (review computed, not posted).
GITHUB_POST_COMMENTS=true

# ---- Webhook rate limit (global fixed window) ----
WEBHOOK_RATE_MAX=100
WEBHOOK_RATE_WINDOW=60

# ---- WebSocket dashboard ----
# Comma-separated origins allowed to open the STOMP/SockJS handshake.
WS_ALLOWED_ORIGINS=http://localhost:8080

# ---- Audit API protection ----
AUDIT_API_KEY=local-dev-key

# ---- Infrastructure (defaults match docker-compose.yml) ----
DB_URL=jdbc:postgresql://localhost:5432/aireviewer
DB_USERNAME=aireviewer
DB_PASSWORD=aireviewer
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
